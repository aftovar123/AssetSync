@AssetSync.Api_HostAddress = http://localhost:5188
# Same values you set with `dotnet user-secrets` (Auth:Clients:N:ClientId / ClientSecret).
@adminSecret = <asset-admin client secret>
@erpSecret = <erp-integration client secret>

# @name adminToken
POST {{AssetSync.Api_HostAddress}}/auth/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=asset-admin&client_secret={{adminSecret}}

###

# @name erpToken
POST {{AssetSync.Api_HostAddress}}/auth/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=erp-integration&client_secret={{erpSecret}}

###

GET {{AssetSync.Api_HostAddress}}/assets
Accept: application/json

###

POST {{AssetSync.Api_HostAddress}}/assets
Authorization: Bearer {{adminToken.response.body.$.access_token}}
Content-Type: application/json

{
  "code": "PUMP-001",
  "name": "Bomba centrífuga"
}

###

POST {{AssetSync.Api_HostAddress}}/work-orders
Authorization: Bearer {{erpToken.response.body.$.access_token}}
Content-Type: application/json

{
  "assetId": 1,
  "description": "Cambio de rodamientos"
}

###

GET {{AssetSync.Api_HostAddress}}/outbox
Authorization: Bearer {{erpToken.response.body.$.access_token}}
Accept: application/json

###
